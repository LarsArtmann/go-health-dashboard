{
  // Live-docs lint. Conventions this repo deliberately keeps:
  // - MD013 off: dprint (treefmt) owns line width and re-wraps.
  // - MD024 siblings_only: Keep-a-Changelog repeats Added/Changed/Fixed per
  //   release; only same-parent duplicates are real mistakes.
  // - MD029 off: historical status/planning reports carry load-bearing
  //   continuous numbering (their file names and cross-references cite
  //   §-item numbers); renumbering would corrupt references.
  // - MD026 off: colon-terminated headings are fleet style ("Notes:").
  // - MD041 off: README opens with badges before the title.
  // Archived report dirs carry their own relaxed config (annotate-only).
  "MD013": false,
  "MD024": { "siblings_only": true },
  "MD029": false,
  "MD026": false,
  "MD041": false
}
