package dashboard

import (
	"fmt"
	"strconv"
	"time"
	"unicode/utf8"

	health "github.com/larsartmann/go-health"
	"github.com/larsartmann/templ-components/datastar"
	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/feedback"
	"github.com/larsartmann/templ-components/icons"
	"github.com/larsartmann/templ-components/layout"
	"github.com/larsartmann/templ-components/utils"
)

// collapseStorageKeyName is the localStorage key the persistence script
// uses when WithPersistCollapse is enabled.
const collapseStorageKeyName = "health-healthy-group-collapsed"

// storageKey returns the CollapsibleSection persistence key when collapse
// persistence is enabled, otherwise empty (no data-collapsible attribute).
// Source-grouped pages never persist: they can render several pass-status
// sections, and one localStorage key shared across them would couple their
// open/closed states.
func storageKey(data viewModel) string {
	if data.PersistCollapse && data.Grouping != GroupBySource {
		return collapseStorageKeyName
	}

	return ""
}

// View renders the full HTML dashboard page: Base shell (no HTMX), Datastar
// SDK in head, PageHeader with the live controls, StatCards, and a LiveRegion
// that auto-connects to the SSE endpoint for real-time health updates.
templ View(data viewModel) {
	@layout.Base(layout.PageProps{
		Title:       data.Title,
		CSSPath:     data.CSSPath,
		Favicon:     data.FaviconURL,
		Nonce:       data.DatastarNonce,
		HTMXVersion: "", // No HTMX — Datastar handles real-time
		HeadContent: dashboardHead(data),
	}) {
		@layout.Container(layout.DefaultContainerProps()) {
			<div class="py-8">
				@display.PageHeader(display.PageHeaderProps{
					Title:    data.Title,
					Subtitle: "Real-time health monitoring",
					Action:   headerActions(data),
				})
				if data.ShowStatCards {
					@display.Grid(display.GridProps{Cols: display.GridCols3}) {
						@display.StatCard(display.StatCardProps{
							Value: versionOrUnknown(data.Version),
							Label: "Version",
							Tone:  display.StatTonePurple,
							Icon:  icons.Tag,
						})
						@display.StatCard(display.StatCardProps{
							Value: data.Uptime,
							Label: "Uptime",
							Tone:  display.StatToneBlue,
							Icon:  icons.Clock,
						})
						@latencyStatCard(data)
						if data.InstanceID != "" {
							@display.StatCard(display.StatCardProps{
								Value: data.InstanceID,
								Label: "Instance",
								Tone:  display.StatTonePurple,
								Icon:  icons.Server,
							})
						}
					}
				}
				<div class="mt-6">
					@datastar.LiveRegion(datastar.LiveRegionProps{
						BaseProps: utils.BaseProps{ID: "health-region", Nonce: data.DatastarNonce},
						URL:       data.SSEURL,
						AutoStart: true,
						Live:      datastar.LivePolite,
						// A graceful server restart ends the SSE stream with a
						// clean EOF, which the SDK's default retry mode treats
						// as a completed request and never reconnects — every
						// browser would go stale until reloaded. RetryAlways
						// re-runs the connect across restarts (the failure
						// counter resets on every successful connect).
						Retry: datastar.RetryAlways,
					}) {
						@dashboardContent(data)
					}
				</div>
				@pageBootstrap(data)
			</div>
		}
	}
}

// dashboardHead renders the head additions: the Datastar SDK script (self-
// hosted when DatastarSrc is set, otherwise the jsdelivr CDN) and Tailwind
// CSS via the Play CDN (when no compiled CSSPath is provided).
templ dashboardHead(data viewModel) {
	if data.Description != "" {
		<meta name="description" content={ data.Description }/>
		<meta property="og:title" content={ data.Title }/>
		<meta property="og:description" content={ data.Description }/>
		<meta property="og:type" content="website"/>
	}
	if data.DatastarSrc != "" {
		@datastar.SDKScript(datastar.SDKScriptProps{
			BaseProps: utils.BaseProps{Nonce: data.DatastarNonce},
			Src:       data.DatastarSrc,
		})
	} else {
		@datastar.SDKScript(datastar.SDKScriptProps{
			BaseProps: utils.BaseProps{Nonce: data.DatastarNonce},
			Version:   datastar.DatastarVersion1_0_3,
		})
	}
	if data.CSSPath == "" {
		if data.TailwindNonce != "" {
			<script nonce={ data.TailwindNonce } src="https://cdn.tailwindcss.com"></script>
			<script nonce={ data.TailwindNonce }>
				tailwind.config = {
					darkMode: 'class'
				}
			</script>
		} else {
			<script src="https://cdn.tailwindcss.com"></script>
			<script>
				tailwind.config = {
					darkMode: 'class'
				}
			</script>
		}
	}
}

// dashboardContent renders the alert banner, optional health trend card, and
// check-group cards. This is the shared inner content used by both the
// initial page render (inside the LiveRegion) and the SSE patches (which
// replace it with fresh data).
templ dashboardContent(data viewModel) {
	{{
		problemsAssigned := false
	}}
	@feedback.Alert(feedback.AlertProps{
		Type:    data.FeedbackType,
		Title:   data.StatusText,
		Message: alertSummary(data),
	})
	<p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
		Updated { data.LastUpdated }
		if !data.LastUpdatedTime.IsZero() {
			if data.PublicMode {
				// Coarse stamp: precise ages fingerprint a deployment
				// (exact restart times, instance uptime) — the anti-
				// fingerprint accepted risk holds for untrusted audiences.
				· { formatAge(data.LastUpdatedTime, time.Now().UTC()) }
			} else if data.InitialRender {
				// Precise, client-ticked age (decided 2026-10-09, Q2).
				// The page render installs the singleton auto-refresh
				// script; the server text is already correct without JS.
				· @display.RelativeTime(display.RelativeTimeProps{
					BaseProps:   utils.BaseProps{Nonce: data.DatastarNonce, Class: "text-xs"},
					Time:        data.LastUpdatedTime,
					AutoRefresh: true,
				})
			} else {
				// Patch render: bare element with the ticking attribute —
				// patches must stay script-free (patch purity invariant),
				// and the singleton script from the page render re-queries
				// time[data-tc-relative] every 30s, so swapped elements
				// keep ticking. formatAge is the honest pre-JS fallback
				// text until the script formats it.
				· <time
					datetime={ data.LastUpdatedTime.Format(time.RFC3339) }
					data-tc-relative
					class="text-xs text-gray-500 dark:text-gray-400"
				>{ formatAge(data.LastUpdatedTime, time.Now().UTC()) }</time>
			}
		}
	</p>
	if !data.Evidence.Since.IsZero() && data.Evidence.Total > 0 {
		<p class="mt-1 text-xs text-gray-500 dark:text-gray-400" title={ evidenceTooltip }>
			{ evidenceSummaryText(data.Evidence) }
		</p>
	}
	if data.ExportURL != "" || data.TrendURL != "" || data.MetricsURL != "" {
		<p class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-xs">
			if data.ExportURL != "" {
				<a class={ endpointLinkClass } href={ data.ExportURL + "?format=csv" }>
					@icons.Icon(icons.Download, "h-3.5 w-3.5")
					Export CSV
				</a>
				<a class={ endpointLinkClass } href={ data.ExportURL }>
					@icons.Icon(icons.Download, "h-3.5 w-3.5")
					Export JSON
				</a>
			}
			if data.TrendURL != "" {
				<a class={ endpointLinkClass } href={ data.TrendURL }>
					@icons.Icon(icons.ArrowTrendingUp, "h-3.5 w-3.5")
					Trend JSON
				</a>
			}
			if data.MetricsURL != "" {
				<a class={ endpointLinkClass } href={ data.MetricsURL }>
					@icons.Icon(icons.Chart, "h-3.5 w-3.5")
					Metrics
				</a>
			}
		</p>
	}
	if hasProblems(data) {
		<p class="mt-2 text-sm">
			<a href="#group-problems" class="font-medium text-red-600 underline decoration-red-300 underline-offset-2 hover:text-red-700 dark:text-red-400 dark:decoration-red-700 dark:hover:text-red-300">
				Jump to problems ↓
			</a>
		</p>
	}
	if data.DatastarSrc != "" && data.HasDatastarRuntime {
		<div class="mt-6">
			<label class="sr-only" for="health-filter">Filter services</label>
			<input
				id="health-filter"
				type="search"
				autocomplete="off"
				placeholder="Filter services…"
				data-bind="query"
				class="block w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100 dark:placeholder-gray-500"
			/>
		</div>
	}
	if len(data.History) >= 2 || len(data.Timeline) > 0 {
		<div class="mt-6">
			if len(data.History) >= 2 && len(data.Timeline) > 0 {
				@display.Grid(display.GridProps{Cols: display.GridCols2}) {
					@trendCard(data)
					@timelineCard(data)
				}
			} else {
				if len(data.History) >= 2 {
					@trendCard(data)
				}
				if len(data.Timeline) > 0 {
					@timelineCard(data)
				}
			}
		</div>
	}
	<div class="mt-6 space-y-6">
		if len(data.Groups) == 0 {
			@display.Card(display.CardProps{Title: "Service Status"}) {
				@display.EmptyState(display.EmptyStateProps{
					Icon:        icons.Inbox,
					Title:       "No services registered yet",
					Description: "Health checks appear here once services are registered with the probe.",
				})
			}
		} else {
			for _, group := range data.Groups {
				if group.Status == health.StatusPass {
					@display.CollapsibleSection(display.CollapsibleSectionProps{
						Title:      healthyGroupSummary(group),
						Collapsed:  data.HealthyCollapsed,
						StorageKey: storageKey(data),
					}) {
						@groupTable(group, data.Evidence)
					}
				} else if !problemsAssigned {
					{{ problemsAssigned = true }}
					@display.Card(display.CardProps{
						BaseProps:    utils.BaseProps{ID: "group-problems"},
						Title:        group.Title,
						Padding:      display.CardPaddingNone,
						HeaderAction: groupCountBadge(len(group.Rows)),
					}) {
						@groupTable(group, data.Evidence)
					}
				} else {
					@display.Card(display.CardProps{
						Title:        group.Title,
						Padding:      display.CardPaddingNone,
						HeaderAction: groupCountBadge(len(group.Rows)),
					}) {
						@groupTable(group, data.Evidence)
					}
				}
			}
		}
		if data.DatastarSrc != "" && data.HasDatastarRuntime && len(data.Groups) > 0 {
			<p
				class="hidden text-sm text-gray-500 dark:text-gray-400"
				role="status"
				data-filter-empty
				data-class:hidden={ filterEmptyExpr(data) }
			>
				No services match your filter.
			</p>
		}
	</div>
}

// groupTable renders the service table shared by every group container.
// Rows are rendered via the Body hook so each <tr> can carry the
// client-side filter attributes.
//
// Mobile (below the sm breakpoint) the table stops being a table: the
// header row hides and each body row stacks into a card with per-cell
// labels (see groupRows). The stacking utilities ride Tailwind variants
// only — no extra stylesheet, no script — so SSE patches carry the same
// classes as the initial render. Requires Tailwind ≥3.1 (arbitrary
// variants); the arbitrary variant on the table element is what hides
// the upstream-rendered <thead>, which has no class hook of its own.
templ groupTable(group checkGroup, ev evidenceSummary) {
	@display.Table(display.TableProps{
		Headers:   []string{"Service", "Status", "Details"},
		Flush:     true,
		Body:      groupRows(group, ev),
		BaseProps: utils.BaseProps{Class: "[&_thead]:max-sm:hidden"},
	})
}

// groupRows renders the table rows for a group, each carrying its filter
// haystack and a data-class-hidden expression that hides the row while the
// query signal is active and does not match. The haystack covers both the
// short display name and the raw check key, case-insensitively.
//
// Below the sm breakpoint each row renders as a stacked card: the row is
// a block with a divider, and every cell shows its label above the value.
// The `:not(.hidden)` guard is load-bearing: the client-side filter hides
// rows by toggling the `hidden` CLASS, and an author display:block inside
// a media query would otherwise out-cascade that toggle (same specificity,
// variant rules sort later in the generated sheet). The guard raises the
// stacking rule's specificity so filtering keeps winning on mobile; if
// the filter ever stops using the `hidden` class, revisit this selector.
templ groupRows(group checkGroup, ev evidenceSummary) {
	for _, row := range group.Rows {
		<tr
			data-filter-row={ filterHaystack(row) }
			data-class:hidden={ "$query !== '' && !" + jsStringLiteral(filterHaystack(row)) + ".includes($query.toLowerCase())" }
			class="max-sm:[&:not(.hidden)]:block max-sm:border-b max-sm:border-gray-200 max-sm:last:border-b-0 dark:max-sm:border-gray-700"
		>
			<td class="px-4 py-3 text-gray-700 dark:text-gray-300">
				<span class="mb-0.5 block text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400 sm:hidden">Service</span>
				@serviceNameCell(row)
			</td>
			<td class="px-4 py-3 text-gray-700 dark:text-gray-300">
				<span class="mb-0.5 block text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400 sm:hidden">Status</span>
				@display.Badge(badgeForStatus(row, ev))
			</td>
			<td class="px-4 py-3 text-gray-700 dark:text-gray-300">
				<span class="mb-0.5 block text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400 sm:hidden">Details</span>
				@rowDetailsCell(row)
			</td>
		</tr>
	}
}

// groupCountBadge renders the row count shown in a group card's header.
templ groupCountBadge(count int) {
	<span class={ "ml-2 inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium tabular-nums", "bg-gray-100 text-gray-600 dark:bg-gray-700 dark:text-gray-300" } aria-label={ fmt.Sprintf("%d service%s", count, pluralS(count)) }>
		{ strconv.Itoa(count) }
	</span>
}

// pluralS returns "s" for counts other than exactly one.
func pluralS(count int) string {
	if count == 1 {
		return ""
	}
	return "s"
}

// serviceNameCell renders the Service column: the shortened display name,
// with the raw check key recoverable via the title attribute.
templ serviceNameCell(row checkRow) {
	<span class="font-medium text-gray-900 dark:text-gray-100" title={ row.Name }>{ row.displayName() }</span>
}

// rowDetailsCell renders the Details column: the error text (long errors
// expand via a native <details>), plus the raw check key as a dim
// monospace line whenever it differs from the shortened display name —
// full fidelity without giving up scannability.
templ rowDetailsCell(row checkRow) {
	if row.Error == "" {
		<span class="text-gray-500 dark:text-gray-400">—</span>
	} else if utf8.RuneCountInString(row.Error) <= errorSummaryMax {
		<span class="break-words text-gray-600 dark:text-gray-300">{ row.Error }</span>
	} else {
		<details class="min-w-0">
			<summary class="cursor-pointer break-all text-gray-600 dark:text-gray-300">{ truncateError(row.Error) }</summary>
			<span class="mt-1 block whitespace-pre-wrap break-words font-mono text-xs text-gray-600 dark:text-gray-400">{ row.Error }</span>
		</details>
	}
	if row.hasShortDisplay() {
		<span class="mt-0.5 block break-all font-mono text-xs text-gray-500 dark:text-gray-400">{ row.Name }</span>
	}
	if row.SinceText != "" || row.DurationText != "" {
		<span class="mt-0.5 block text-xs text-gray-500 dark:text-gray-400">
			if row.SinceText != "" {
				<span title="When the check entered its current status, as observed by the probe">{ row.SinceText }</span>
			}
			if row.DurationText != "" {
				if row.SinceText != "" {
					{ " · " }
				}
				<span title="How long the most recent execution of this check took">{ row.DurationText }</span>
			}
		</span>
	}
}

// trendCard renders the Health Trend sparkline card. Min/Max pin the 0..1
// status scale so the line position is comparable across renders instead of
// auto-rescaling.
templ trendCard(data viewModel) {
	{{
		trendMinVal := 0.0
		trendMaxVal := 1.0
	}}
	@display.Card(display.CardProps{Title: "Health Trend"}) {
		<div class="text-blue-500 dark:text-blue-400">
			@display.Sparkline(display.SparklineProps{
				BaseProps: utils.BaseProps{
					AriaLabel: "Recent health status trend: one point per push interval, from pass (top) to fail (bottom)",
				},
				Values: data.History,
				Filled: true,
				Min:    &trendMinVal,
				Max:    &trendMaxVal,
				Width:  trendWidth,
				Height: trendHeight,
			})
		</div>
	}
}

// timelineCard renders the Status Changes card: one row per recent
// transition, each a direction glyph plus a status badge.
templ timelineCard(data viewModel) {
	@display.Card(display.CardProps{Title: "Status Changes"}) {
		<ol class="divide-y divide-gray-200 dark:divide-gray-700">
			for _, entry := range data.Timeline {
				<li class="flex items-center justify-between gap-4 py-2 text-sm first:pt-0 last:pb-0">
					<time class="font-mono text-gray-500 tabular-nums dark:text-gray-400">{ entry.At }</time>
					<span class="flex items-center gap-1.5">
						@icons.Icon(timelineTrendIcon(entry), timelineTrendIconClass(entry))
						@display.Badge(display.BadgeProps{
							Text: entry.Status,
							Type: timelineBadgeType(entry),
							Size: display.BadgeSizeSM,
						})
					</span>
				</li>
			}
		</ol>
		@timelineNote(len(data.Timeline), data.TimelineTotal)
	}
}

// timelineNote discloses the ring cap when transitions were dropped: the
// "Showing N of M" shape of display.ListNote with honest copy — upstream's
// truncated variant advises "narrow your search", which is wrong for a
// rolling window (no search exists; older entries age out by design). It
// mirrors the ListNote shell classes and role so the notice renders
// identically; the custom-message hook is an upstream filing candidate.
// Only the dashboard's own bounding is disclosed — aged-out entries
// (WithTimelineMaxAge) are the operator's window choice, not truncation.
templ timelineNote(shown, total int) {
	if total > shown {
		<div class="border-t border-gray-200 dark:border-gray-700 px-4 py-2.5 text-xs text-gray-500 dark:text-gray-400" role="status">
			Showing the latest { shown } of { total } status changes.
		</div>
	}
}

// latencyStatCard renders the Check Latency card on the StatCard skeleton.
// Hand-rolled rather than display.StatCard because the reactive value tone
// needs a hook upstream lacks: StatCardProps cannot color the <dd>, and its
// yellow tile ships text-yellow-600 (~2.9:1 on white — the same failure
// class the page-wide WCAG scan bans for green/amber-600). So the tile
// keeps the metrics blue in every state (the two-family tone system) while
// the value text carries the budget judgment in this page's validated
// warn/critical pairs. Neutral bytes mirror StatCard output; the goldens
// pin that fidelity. The native title tooltip keeps the honest framing the
// upstream Tooltip component can't provide here (it emits its aria script
// with a nonce attribute even for nonce-less pages).
templ latencyStatCard(data viewModel) {
	<div
		class={ utils.Class("bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 shadow-xs print:shadow-none print:border-0 print:bg-transparent p-5") }
		title="Duration of the most recent probe batch across all services, refreshed every probe interval"
	>
		<div class="flex items-center gap-4">
			<div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-lg bg-blue-50 dark:bg-blue-900/30">
				@icons.Icon(icons.Bolt, "h-6 w-6 text-blue-600 dark:text-blue-400")
			</div>
			<dl class="min-w-0 flex-1">
				<div class="mt-1 flex flex-col">
					<dt class="text-sm font-medium text-gray-500 dark:text-gray-400 truncate">Check Latency</dt>
					<dd class={ "text-2xl font-semibold", latencyValueClass(data.LatencyTone) }>
						{ fmt.Sprintf("%dms", data.LatencyMs) }
					</dd>
				</div>
			</dl>
		</div>
	</div>
}

// headerActions renders the PageHeader action slot: the SSE connection pill
// (when the SDK runtime is present) and the theme toggle. Lives outside the
// SSE-patched region, so both controls survive every content update.
templ headerActions(data viewModel) {
	<div class="flex items-center gap-3">
		if data.HasDatastarRuntime {
			@connectionPill()
		}
		@themeToggle()
	</div>
}

// endpointLinkClass styles the operator endpoint links (export, trend,
// metrics). One shared declaration keeps the four render sites in lockstep.
const endpointLinkClass = "inline-flex items-center gap-1 font-medium text-blue-600 underline decoration-blue-300 underline-offset-2 hover:text-blue-700 dark:text-blue-400 dark:decoration-blue-700 dark:hover:text-blue-300"

// timelineBadgeType maps a timeline entry to its badge style: a transition
// away from pass is the warning story, a recovery the success one, and an
// off entry the neutral one (go-health v0.5.1: off is visibility — neither
// a degradation nor a recovery).
func timelineBadgeType(entry TimelineEntry) display.BadgeType {
	switch {
	case entry.Status == string(health.StatusOff):
		return display.BadgeNeutral
	case entry.Degraded:
		return display.BadgeWarning
	default:
		return display.BadgeSuccess
	}
}

// timelineTrendIcon picks the direction glyph: an arrow down when the
// service degraded, a trending-up arrow when it recovered, a minus for off
// (an unconfigured dependency flipped — neither up nor down). Decorative
// only — the adjacent badge carries the status text.
func timelineTrendIcon(entry TimelineEntry) icons.Name {
	switch {
	case entry.Status == string(health.StatusOff):
		return icons.Minus
	case entry.Degraded:
		return icons.ArrowDown
	default:
		return icons.ArrowTrendingUp
	}
}

// timelineTrendIconClass colors the direction glyph to match its badge tone.
// The -700 light variants carry the WCAG AA contrast decisions locked by
// TestRender_ContrastSafeStatusColors (-600 fails on white); off uses the
// page's notice gray (4.83:1 on white).
func timelineTrendIconClass(entry TimelineEntry) string {
	switch {
	case entry.Status == string(health.StatusOff):
		return "h-4 w-4 text-gray-500 dark:text-gray-400"
	case entry.Degraded:
		return "h-4 w-4 text-amber-700 dark:text-amber-400"
	default:
		return "h-4 w-4 text-green-700 dark:text-green-400"
	}
}

// versionOrUnknown returns the version string or "unknown" when empty.
func versionOrUnknown(v string) string {
	if v == "" {
		return "unknown"
	}
	return v
}

// Trend sparkline geometry (the 0..1 Min/Max scale is pinned in trendCard).
const (
	trendWidth  = 480
	trendHeight = 64
)
